# =============================================================================
# Root Local Testing / Simulation Environment
# =============================================================================
# This file is ONLY used by docker-compose.local.yml to configure container 
# infrastructure and map ports. Application secrets and environment variables 
# are now managed within their respective directories:
# - agent-system/apps/backend/.env.local
# - client-system/packages/widget-backend/.env.local
# - agent-system/apps/frontend/.env.local
# - client-system/packages/widget-frontend/.env.local

# ─────────────────────────────────────────────────────────
# 1. PostgreSQL & Redis Infrastructure Setup
# ─────────────────────────────────────────────────────────
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_PASSWORD=localdev123

# ─────────────────────────────────────────────────────────
# 2. Container Port Mappings (Exposed to Host 127.0.0.1)
# ─────────────────────────────────────────────────────────
AGENT_FRONTEND_PORT=4172
AGENT_BACKEND_PORT=3003
WIDGET_FRONTEND_PORT=4171
WIDGET_BACKEND_PORT=3002
