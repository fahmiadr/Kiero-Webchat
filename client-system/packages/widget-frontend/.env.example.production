# =============================================================================
# Widget Frontend (Production Build)
# =============================================================================

# Connects directly to production backend via the Global Nginx Proxy
VITE_WIDGET_BACKEND_URL=https://widget-api.yourdomain.com
VITE_BASE_PATH=/
VITE_SOCKET_PATH=

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Dev Client ID (Can be empty in real production unless needed)
VITE_DEV_CLIENT_ID=