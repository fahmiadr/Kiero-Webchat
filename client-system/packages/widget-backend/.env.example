# Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Redis Configuration
REDIS_URL="redis://:changeme_in_production@localhost:6379"

# Webhook Configuration
WEBHOOK_TIMEOUT=5000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_SECRET="agent-system-webhook-secret"

# External Backend API (For Webhooks & History)
# Development: http://localhost:4000
# Production: https://api.your-backend.com
AGENT_BACKEND_URL="http://localhost:3002"

# Public URL for agent-backend (used for file URLs stored in database)
# This should be the publicly accessible URL that frontends can reach
# Development: same as AGENT_BACKEND_URL
# Production: https://api.yourdomain.com (public/external URL)
AGENT_BACKEND_PUBLIC_URL="http://localhost:3002"