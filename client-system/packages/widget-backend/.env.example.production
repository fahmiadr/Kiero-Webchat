# =============================================================================
# Widget Backend (Production Ready Example)
# =============================================================================

NODE_ENV=production
PORT=3002
LOG_LEVEL=info

# Redis (Production URL)
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379"

# Webhook
WEBHOOK_TIMEOUT=5000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_SECRET="CHANGE_ME_SECURE_WEBHOOK_SECRET"

# Agent Backend URL (Use Docker internal network for direct comms)
AGENT_BACKEND_URL="http://agent-backend:3003"

# Public Agent Backend URL (For browsers)
AGENT_BACKEND_PUBLIC_URL="https://api.yourdomain.com"
