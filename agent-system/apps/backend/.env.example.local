# =============================================================================
# Agent Backend (Local Docker Development)
# =============================================================================
# Copy this to .env.local for docker-compose local testing

NODE_ENV=production
PORT=3003
LOG_LEVEL=info

# Database — Docker internal network
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/agent_db?schema=public"

# Redis — Docker internal network
REDIS_URL="redis://:localdev123@redis:6379"

# Security (Development)
JWT_SECRET="local-testing-jwt-secret-do-not-use-in-production-64chars-min-pad"
WEBHOOK_SECRET="local-testing-webhook-secret"
ENCRYPTION_KEY="local-testing-encryption-key-pad"

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:4172"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=50
RATE_LIMIT_REFRESH_MAX=100
RATE_LIMIT_UPLOAD_MAX=50
RATE_LIMIT_WIDGET_MAX=200
RATE_LIMIT_WINDOW="1 minute"
RATE_LIMIT_ALLOW_LIST="127.0.0.1"

# Token Expiry
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
