# =============================================================================
# Agent Backend (Production Ready Example)
# =============================================================================

NODE_ENV=production
PORT=3003
LOG_LEVEL=info

# Database (Production URL)
DATABASE_URL="postgresql://postgres:CHANGE_ME_SECURE_PASSWORD@postgres:5432/agent_db?schema=public"

# Redis (Production URL)
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379"

# Security (Must be cryptographically random 64 min characters)
JWT_SECRET="CHANGE_ME_MIN_64_CHARACTERS_JWT_SECRET_STRING_DO_NOT_GUESS"
WEBHOOK_SECRET="CHANGE_ME_SECURE_WEBHOOK_SECRET"
ENCRYPTION_KEY="CHANGE_ME_SECURE_ENCRYPTION_KEY_32BYTES"

# Frontend URL (CORS - Actual Domain)
FRONTEND_URL="https://agent.yourdomain.com"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REFRESH_MAX=50
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_WIDGET_MAX=300
RATE_LIMIT_WINDOW="1 minute"
RATE_LIMIT_ALLOW_LIST="127.0.0.1"

# Token Expiry
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
