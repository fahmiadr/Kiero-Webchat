# Environment
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_db?schema=public"

# Redis
REDIS_URL="redis://:changeme_in_production@localhost:6379"

# Security (JWT & HMAC)
JWT_SECRET="agent-system-jwt-secret-dev-key"
WEBHOOK_SECRET="agent-system-webhook-secret"
ENCRYPTION_KEY="strong-encryption-key"

# Frontend URL (For CORS)
FRONTEND_URL="http://localhost:5174,http://localhost:4172"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_WIDGET_MAX=60
RATE_LIMIT_WINDOW="1 minute"
RATE_LIMIT_ALLOW_LIST="127.0.0.1"

# Token Expiry
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
