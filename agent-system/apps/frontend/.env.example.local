# =============================================================================
# Agent Frontend (Local Node/Vite Development)
# =============================================================================
# cp .env.example.local .env.local

# Connects directly to the Agent Backend (running locally on port 3003)
VITE_API_URL=http://localhost:3003/api
VITE_BASE_PATH=/
VITE_SOCKET_PATH=

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Connects directly to the Widget Frontend (running locally on port 4171)
VITE_WIDGET_FRONTEND_URL=http://localhost:4171/
