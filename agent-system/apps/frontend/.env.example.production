# =============================================================================
# Agent Frontend (Production Build)
# =============================================================================
# cp .env.example.production .env.production

# Connects to the Global Nginx Proxy (which routes to agent-backend 3003)
VITE_API_URL=https://api.yourdomain.com/api
# Base path if proxy maps domain.com/webchat/ to the frontend:
VITE_BASE_PATH=/
VITE_SOCKET_PATH=

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Connects to the Widget Frontend
VITE_WIDGET_FRONTEND_URL=https://widget.yourdomain.com