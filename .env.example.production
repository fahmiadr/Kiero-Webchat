# =============================================================================
# Root Production Environment
# =============================================================================
# cp .env.example.production .env.production
# This file is ONLY used by docker-compose.prod.yml to configure container 
# infrastructure and map ports. Application secrets and environment variables 
# are now managed within their respective directories:
# - agent-system/apps/backend/.env.production
# - client-system/packages/widget-backend/.env.production
# - agent-system/apps/frontend/.env.production
# - client-system/packages/widget-frontend/.env.production

# ─────────────────────────────────────────────────────────
# 1. PostgreSQL & Redis Infrastructure Setup
# ─────────────────────────────────────────────────────────
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─────────────────────────────────────────────────────────
# 2. Container Port Mappings (Exposed to Host 127.0.0.1)
# ─────────────────────────────────────────────────────────
AGENT_FRONTEND_PORT=14172
AGENT_BACKEND_PORT=13003
WIDGET_FRONTEND_PORT=14171
WIDGET_BACKEND_PORT=13002
